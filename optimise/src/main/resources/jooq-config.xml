<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<configuration>
    <jdbc>
        <driver>org.postgresql.Driver</driver>
        <url>jdbc:postgresql://localhost:5432/optimise_db</url>
        <user>postgres</user>
        <password>123456</password>
    </jdbc>

    <generator>
        <generate>
<!--            <catalogs>false</catalogs>-->
<!--            <schemata>false</schemata>-->
            <fluentSetters>true</fluentSetters>
        </generate>
        <database>
            <name>org.jooq.meta.postgres.PostgresDatabase</name>
            <inputSchema>public</inputSchema>
            <includes>.*</includes>
            <excludes>databasechangelog.*|databasechangeloglock.*</excludes>
            <forcedTypes>
                <forcedType>
                    <userType>java.time.Instant</userType>
                    <includeTypes>.*timestamp.*</includeTypes>
                </forcedType>
            </forcedTypes>
        </database>
        <target>
            <packageName>com.xuanluan.practice.optimise.generated</packageName>
            <directory>target/generated-sources/jooq</directory>
        </target>
    </generator>
</configuration>
