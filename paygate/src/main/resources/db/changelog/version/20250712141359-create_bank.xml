<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="20250712141359-create_bank" author="xuanluan">
        <createTable tableName="bank">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="now()"/>
            <column name="updated_at" type="timestamp" defaultValueComputed="now()"/>
            <!-- Add changes here -->
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="bin" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="short_name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="swift_code" type="varchar(50)"/>
            <column name="logo" type="varchar(250)"/>
            <column name="is_deleted" type="boolean" defaultValueBoolean="false"/>
        </createTable>

        <addColumn tableName="payment">
            <column name="bank_id" type="uuid">
                <constraints references="bank(id)" foreignKeyName="fk_payment_bank_id"
                             validateForeignKey="true" nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="payment" columnName="bank_id"/>
            <dropTable tableName="bank"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
